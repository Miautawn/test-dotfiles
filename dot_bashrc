# If not running interactively, don't do anything
[[ $- != *i* ]] && return

#########
# PATHS #
#########

# Adds local executable directory to path
export PATH="$PATH:$HOME/.local/bin"

################
# PRIVATE BASH #
################
[[ -f ~/.bashrc_private ]] && . ~/.bashrc_private

#############
# VARIABLES #
#############
export EDITOR="nvim"

###########
# Aliases #
###########
[[ -f ~/.bash_aliases ]] && . ~/.bash_aliases
[[ -f ~/.bash_private_aliases ]] && . ~/.bash_private_aliases

#############
# Functions #
#############
[[ -f ~/.bash_functions ]] && . ~/.bash_functions

##############
# YAZI STUFF #
##############

# This function enables you to start yazi with 'y'
# and it will exit at the location you navigated
# use capital Q to stay at the original CWD
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

#################
# LAZYGIT STUFF #
#################

# Allows you to cd to exit directory (for example when switching worktrees)
lg() {
    export LAZYGIT_NEW_DIR_FILE=~/.lazy-git-new-dir
    lazygit "$@"
    if [ -f "$LAZYGIT_NEW_DIR_FILE" ]; then
        cd "$(cat "$LAZYGIT_NEW_DIR_FILE")" || return
        rm -f "$LAZYGIT_NEW_DIR_FILE"
    fi
}

#####################
# CLAUDE CODE STUFF #
#####################
# allows running claude with working-directory isolation for autonamous background task
claude-slave() {
  CLAUDE_PROJECT_DIR="$PWD" claude --settings "$HOME/.claude/autonomous.json" "$@" --append-system-prompt "You are running in a sandboxed, unattended session confined to the current project directory. If you need to create a PR, simply generate a fully qualified 'gh pr create' commans for the user to execute. Do not try to execute the PR yourself"
}
